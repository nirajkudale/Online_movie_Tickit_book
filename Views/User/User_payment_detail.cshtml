@model List<Onlinemovietickitproject.Models.BookingConfirmationViewModel>
@{
    ViewBag.Title = "Your Payment Details";
}
<h2 class="text-center my-4">Payment History</h2>
<link href="~/Css/Userpaymentshit.css" rel="stylesheet" />
<div class="container">
    @foreach (var item in Model)
    {
        <div class="card mb-4 shadow-sm border-primary">
            <div class="card-body">
                <h5 class="card-title">Booking ID: @item.Booking.BookingID</h5>
                <p><strong>Theatre:</strong> @item.TheatreName</p>
                <p><strong>Moviename:</strong> @item.MovieTitle</p>
                <p><strong>Showtime:</strong> @item.Booking.Showtime.StartTime</p>
                <p><strong>Seats:</strong> @item.Booking.SeatNumbers (@item.Booking.SeatTypes)</p>
                <p><strong>Total Price:</strong> ₹@item.Booking.TotalPrice</p>
                <hr />
                <p><strong>Payment Method:</strong> @item.Payment.PaymentMethod</p>
                <p><strong>Transaction ID:</strong> @item.Payment.TransactionID</p>
                <p><strong>Amount Paid:</strong> ₹@item.Payment.Amount</p>
                <p><strong>Status:</strong> <span class="badge badge-success">@item.Payment.PaymentStatus</span></p>
                <p><strong>Details:</strong> @item.Payment.PaymentDetails</p>
                <p><strong>QR Code:</strong></p>
                <img src="@Url.Action("GenerateQRCode", "User", new { transactionId = item.Payment.TransactionID })" alt="QR Code" width="150" />

                <form action="@Url.Action("DeletePayment", "User")" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentId" value="@item.Payment.PaymentID" />
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this payment?');">Delete</button>
                </form>
            </div>
        </div>
    }
</div>
