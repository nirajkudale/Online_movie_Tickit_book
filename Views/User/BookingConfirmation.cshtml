@model Onlinemovietickitproject.Models.BookingConfirmationViewModel

@{
    ViewBag.Title = "Booking Confirmation";
}

<link href="~/Css/IndexShit.css" rel="stylesheet" />

<div class="card p-4 shadow">
    <h2 class="text-success">Booking Confirmed!</h2>
    <hr />

    <h4>Booking Details</h4>
    <p><strong>Booking ID:</strong> @Model.BookingID</p>
    <p><strong>Movie:</strong> @Model.MovieTitle</p>
    <p><strong>Theater:</strong> @Model.TheaterName</p>
    <p><strong>Show Time:</strong> @DateTime.Today.Add(@Model.StartTime).ToString("f")</p>
    <p><strong>Booking Date:</strong> @Model.BookingDate.ToString("f")</p>

    <h5>Seats:</h5>
    <ul>
        @for (int i = 0; i < Model.SeatsBooked.Count; i++)
        {
            <li>@Model.SeatsBooked[i] - @Model.SeatTypes[i]</li>
        }
    </ul>

    <p><strong>Total Paid:</strong> ₹@Model.TotalPrice</p>

    <h5>Payment Information</h5>
    <p><strong>Status:</strong> @Model.PaymentStatus</p>
    <p><strong>Transaction ID:</strong> @Model.TransactionID</p>

    <div class="mt-4">
        <a href="@Url.Action("Index", "User")" class="btn btn-primary">Back to Home</a>
      
    </div>
</div>
