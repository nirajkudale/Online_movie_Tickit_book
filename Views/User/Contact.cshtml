@{
    ViewBag.Title = "Contact MovieHub";
}

<link href="~/Css/Contactshit.css" rel="stylesheet" />

<div class="container-fluid contact-hero text-center">
    <h1 class="display-4 text-white fw-bold">Get in Touch</h1>
    <p class="lead text-white">We'd love to hear from you. Feel free to reach out!</p>
</div>

<div class="container contact-form-section mt-5">
    <div class="row">
        <div class="col-md-7">
            <form method="post" action="/Home/Contact" class="contact-form">
                <div class="mb-4">
                    <label class="form-label">Your Name</label>
                    <input type="text" class="form-control" name="Name" required />
                </div>
                <div class="mb-4">
                    <label class="form-label">Email Address</label>
                    <input type="email" class="form-control" name="Email" required />
                </div>
                <div class="mb-4">
                    <label class="form-label">Message</label>
                    <textarea class="form-control" name="Message" rows="5" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
        <div class="col-md-5 contact-info">
            <h5>Contact Info</h5>
            <p><strong>Email:</strong> support@moviehub.com</p>
            <p><strong>Phone:</strong> +1 800 123 4567</p>
            <p><strong>Address:</strong> 123 Movie Lane, Filmtown, CA</p>

            <!-- Social Media Links -->
            <div class="social-icons">
                <a href="#" class="fab fa-facebook-f"></a>
                <a href="#" class="fab fa-twitter"></a>
                <a href="#" class="fab fa-instagram"></a>
                <a href="#" class="fab fa-youtube"></a>
            </div>
            <iframe class="w-100" height="250" frameborder="0" style="border:0"
                    src="https://maps.google.com/maps?q=Mumbai,Maharashtra&t=&z=13&ie=UTF8&iwloc=&output=embed"
                    allowfullscreen></iframe>

        </div>
    </div>
</div>
