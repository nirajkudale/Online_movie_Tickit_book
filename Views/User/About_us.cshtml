@{
    ViewBag.Title = "About Us";
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="~/Css/Aboutshit.css" rel="stylesheet" />

<div class="about-page">
    <!-- Hero Section -->
    <section class="about-hero">
        <div class="container text-center fade-in-up">
            <h1 class="display-3 fw-bold mb-3">About MovieTicket</h1>
            <p class="lead">Your gateway to unforgettable cinematic experiences</p>
        </div>
    </section>

    <!-- Mission Section -->
    <section class="mission-section py-5">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2 class="fw-bold mb-4 position-relative pb-2">
                        Our Mission
                        <span class="position-absolute bottom-0 start-0 w-25 bg-danger" style="height: 3px;"></span>
                    </h2>
                    <p class="fs-5 mb-4">We're revolutionizing the way you experience movies by providing a seamless, intuitive platform for discovering and booking tickets to the latest films. Our goal is to make moviegoing more accessible, convenient, and enjoyable for everyone.</p>
                    <div class="d-flex flex-wrap gap-4">
                        <div class="text-center">
                            <div class="stat-number">10M+</div>
                            <div class="text-muted">Tickets Booked</div>
                        </div>
                        <div class="text-center">
                            <div class="stat-number">500+</div>
                            <div class="text-muted">Cinemas Nationwide</div>
                        </div>
                        <div class="text-center">
                            <div class="stat-number">24/7</div>
                            <div class="text-muted">Customer Support</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <img src="https://static.vecteezy.com/system/resources/thumbnails/026/807/880/small_2x/an-atmospheric-setting-of-an-old-fashioned-movie-theater-the-dimly-lit-auditorium-adorned-with-velvet-drapes-generative-ai-photo.jpg"
                         alt="Cinema Image"
                         class="img-fluid rounded shadow" />
                </div>

            </div>
        </div>
    </section>

    <!-- Values Section -->
    <section class="py-5">
        <div class="container">
            <h2 class="fw-bold text-center mb-5 position-relative pb-2">
                Our Core Values
                <span class="position-absolute bottom-0 start-50 translate-middle-x w-25 bg-danger" style="height: 3px;"></span>
            </h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 value-card">
                        <div class="card-body text-center">
                            <div class="value-icon">🎬</div>
                            <h3 class="fw-bold">Passion for Cinema</h3>
                            <p class="text-muted">We're movie lovers first, committed to bringing you the best cinematic experiences.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 value-card">
                        <div class="card-body text-center">
                            <div class="value-icon">⚡</div>
                            <h3 class="fw-bold">Innovation</h3>
                            <p class="text-muted">Constantly improving our platform to make your experience smoother and more enjoyable.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 value-card">
                        <div class="card-body text-center">
                            <div class="value-icon">🤝</div>
                            <h3 class="fw-bold">Customer First</h3>
                            <p class="text-muted">Your satisfaction is our top priority, from booking to the final credits.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="fw-bold text-center mb-5 position-relative pb-2">
                Meet Our Team
                <span class="position-absolute bottom-0 start-50 translate-middle-x w-25 bg-danger" style="height: 3px;"></span>
            </h2>
            <div class="row justify-content-center g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-sm h-100 member-card">
                        <div class="image-placeholder"><img src="https://cdn0.iconfinder.com/data/icons/avatar-4/512/Manager-512.png" /></div>
                        <div class="card-body text-center">
                            <h3 class="fw-bold">Niraj Kudale</h3>
                            <p class="position">Backend developer, API integrator</p>
                            <p class="text-muted">Focused on scalable backend architecture and clean code principles.</p>
                        </div>

                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-sm h-100 member-card">
                        <div class="image-placeholder"><img src="https://cdn0.iconfinder.com/data/icons/avatar-4/512/Manager-512.png" /></div>
                        <div class="card-body text-center">
                            <h3 class="fw-bold">Omkar mahadik</h3>
                            <p class="position">Frontend developer  , database designer</p>
                            <p class="text-muted">Tech visionary passionate about creating seamless user experiences.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section py-5">
        <div class="container text-center">
            <h2 class="fw-bold mb-4">Ready for your next movie experience?</h2>
            <a href="@Url.Action("Index", "User")" class="btn btn-light btn-lg px-4 py-2 fw-bold">
                Book Tickets Now
            </a>
        </div>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>