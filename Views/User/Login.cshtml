@model Onlinemovietickitproject.Models.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - MovieTicket</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="~/Css/Loginshit.css" rel="stylesheet" />
</head>
<body class="login-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-lg-5 col-md-7">
                <div class="auth-card card shadow-lg">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <div class="mb-3 text-start">
                                <a href="@Url.Action("Index", "User")" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-arrow-left me-2"></i>
                                </a>
                            </div>
                            <h3 class="auth-title">Welcome Back!</h3>
                            <p class="text-muted">Sign in to continue to your account</p>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-group mb-3">
                                @Html.LabelFor(x => x.EmailOrUsername, new { @class = "form-label" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    @Html.TextBoxFor(x => x.EmailOrUsername, new
                                    {
                                        @class = "form-control",
                                        placeholder = "Enter email or username",
                                        required = "required"
                                    })
                                </div>
                                <span class="text-danger">@Html.ValidationMessageFor(x => x.EmailOrUsername)</span>
                            </div>

                            <div class="form-group mb-4">
                                @Html.LabelFor(x => x.Password, new { @class = "form-label" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    @Html.PasswordFor(x => x.Password, new
                                    {
                                        @class = "form-control",
                                        placeholder = "Enter your password",
                                        required = "required"
                                    })
                                </div>
                                <span class="text-danger">@Html.ValidationMessageFor(x => x.Password)</span>
                            </div>

                            <div class="d-flex justify-content-between mb-4">
                                <div class="form-check">
                                    @Html.CheckBoxFor(x => x.RememberMe, new { @class = "form-check-input", id = "rememberMe" })
                                    <label class="form-check-label" for="rememberMe">
                                        Remember me
                                    </label>
                                </div>
                                <a href="#" class="text-primary">Forgot password?</a>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 mb-3">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </button>

                            <div class="text-center mt-3 text-danger">
                                @ViewBag.Error
                            </div>

                            <div class="text-center mt-4">
                                <p class="text-muted">
                                    Don't have an account?
                                    <a href="@Url.Action("Register", "User")" class="text-primary fw-bold">Sign up</a>
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script>
        // Add slight animation to form elements
        document.addEventListener('DOMContentLoaded', function () {
            const inputs = document.querySelectorAll('.form-control');
            inputs.forEach(input => {
                input.addEventListener('focus', function () {
                    this.parentElement.style.transform = 'scale(1.01)';
                });
                input.addEventListener('blur', function () {
                    this.parentElement.style.transform = 'scale(1)';
                });
            });
        });
    </script>
</body>
</html>