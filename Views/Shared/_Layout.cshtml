<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MovieTicket</title>
    <meta name="description" content="Book movie tickets online for the latest releases. Your premier destination for cinema experiences.">
    <meta name="keywords" content="movies, cinema, tickets, booking, showtimes">

    <!-- Preload -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" as="style">
    <link rel="preload" href="~/Content/bootstrap.min.css" as="style">
    <link rel="preload" href="~/Css/Navshit.css" as="style">

    <!-- Preconnect to CDNs -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">

    <!-- Favicon -->
    <link rel="icon" href="~/favicon.ico" type="image/x-icon">

    <!-- CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous" referrerpolicy="no-referrer">
    <link href="~/Css/Navshit.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "User")" aria-label="TicketVista Home">
                <i class="fas fa-film me-2" aria-hidden="true"></i>TicketVista
            </a>

          

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("Index", "User")" aria-current="page">
                            <i class="fas fa-home nav-icon me-1" aria-hidden="true"></i>
                            <span class="nav-link-content">Home</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Movie", "User")">
                            <i class="fas fa-ticket-alt nav-icon me-1" aria-hidden="true"></i>
                            <span class="nav-link-content">Movies</span>
                        </a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("User_payment_detail", "User")">
                                <i class="fas fa-wallet nav-icon me-1" aria-hidden="true"></i>
                                <span class="nav-link-content">Payments</span>
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About_us", "User")">
                            <i class="fas fa-info-circle nav-icon me-1" aria-hidden="true"></i>
                            <span class="nav-link-content">About Us</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contact", "User")">
                            <i class="fas fa-envelope nav-icon me-1" aria-hidden="true"></i>
                            <span class="nav-link-content">Contact</span>
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a class="nav-link" href="@Url.Action("Logout", "User")">
                            <i class="fas fa-sign-out-alt nav-icon me-1" aria-hidden="true"></i>
                            <span>Logout-@User.Identity.Name</span>
                        </a>
                    }
                    else
                    {
                        <a class="nav-link" href="@Url.Action("Login", "User")">
                            <i class="fas fa-sign-in-alt nav-icon me-1" aria-hidden="true"></i>
                            <span>Login</span>
                        </a>
                        <a class="nav-link" href="@Url.Action("Register", "User")">
                            <i class="fas fa-user-plus nav-icon me-1" aria-hidden="true"></i>
                            <span>Register</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4" id="main-content">
        @RenderBody()
    </main>

    <footer class="footer" role="contentinfo">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-about">
                    <div class="footer-logo" aria-label="MovieFlix">TicketVista</div>
                    <p>Your premier destination for the latest movies, showtimes, and ticket bookings. Experience cinema like never before.</p>

                    <div class="social-links" aria-label="Social media links">
                        <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <div class="footer-links">
                    <h3 class="footer-heading">Quick Links</h3>
                    <ul class="footer-nav">
                        <li><a href="@Url.Action("Index", "User")">Home</a></li>
                        <li><a href="@Url.Action("Movie", "User")">Movies</a></li>
                    </ul>
                </div>

                <div class="footer-links">
                    <h3 class="footer-heading">Information</h3>
                    <ul class="footer-nav">
                        <li><a href="@Url.Action("About_us", "User")">About Us</a></li>
                        <li><a href="@Url.Action("Contact", "User")">Contact Us</a></li>
                    </ul>
                </div>

                <div class="footer-contact">
                    <h3 class="footer-heading">Contact Us</h3>
                    <address>
                        <p><i class="fas fa-map-marker-alt" aria-hidden="true"></i> 123 Cinema Street, Movie City, MC 12345</p>
                        <p><i class="fas fa-phone-alt" aria-hidden="true"></i> <a href="tel:+12345678900">+91 9084657638</a></p>
                        <p><i class="fas fa-envelope" aria-hidden="true"></i> <a href="mailto:info@TicketVista.com">info@TicketVista.com</a></p>
                    </address>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year TicketVista. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
   
  

    

    @RenderSection("scripts", required: false)
</body>
</html>