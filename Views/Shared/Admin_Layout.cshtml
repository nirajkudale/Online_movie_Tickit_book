@{
    Layout = null;
    ViewBag.Title = "Admin Panel";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Admincss/Layout.css">
   
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebarMenu">
        <h4 class="text-center text-white mb-4">🎬 Admin</h4>
        <a href="@Url.Action("Index", "Admin")"><i class="fas fa-home me-2"></i> Dashboard</a>
        <a href="@Url.Action("Movie_detail", "Admin")"><i class="fas fa-film me-2"></i> Movies</a>
        <a href="@Url.Action("Theater_detail", "Admin")"><i class="fas fa-building me-2"></i> Theaters</a>
        <a href="@Url.Action("User_detail", "Admin")"><i class="fas fa-users me-2"></i> Users</a>
        <a href="@Url.Action("Logout", "Admin")"><i class="fas fa-sign-out-alt me-2"></i> Logout</a>
    </div>

    <!-- Main Content -->
    <div class="w-100" id="mainContent">
        <!-- Navbar -->
        <div class="top-navbar d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <span class="menu-toggle d-md-none" onclick="toggleSidebar()">
                    <i class="fas fa-bars fa-lg me-2"></i>
                </span>
                <h5 class="mb-0">@ViewBag.Title</h5>
            </div>

            <div class="dropdown">
                <img src="https://img.icons8.com/?size=100&id=23441&format=png&color=000000"
                     class="profile-img dropdown-toggle"
                     data-bs-toggle="dropdown"
                     aria-expanded="false" />
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="@Url.Action("Login", "User")"><i class="fas fa-sign-in-alt me-2"></i> Login</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Admin")"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="main-content">
            @RenderBody()
        </div>

        <div class="footer">
            &copy; 2025 Movie Ticket Admin
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebarMenu");
            sidebar.classList.toggle("active");
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
